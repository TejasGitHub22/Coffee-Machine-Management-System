# Root ignores for Coffee-App mono-repo

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/frontend.log

# Java / Maven
backend/target/
simulator/target/
backend/.mvn/wrapper/maven-wrapper.jar
simulator/.mvn/wrapper/maven-wrapper.jar

# IDE / Editors
.vscode/
.idea/
backend/.idea/
simulator/.idea/

# Logs
**/*.log
backend/backend_startup.log
backend/backend.log

# OS files
.DS_Store
Thumbs.db

# Env
*.env
*.env.local

# Misc
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
